<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <!-- Gazebo Harmonic uses the DiffDrive system plugin -->
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            
            <!-- We define the joints for each side. 
                 Note: For 6-wheelers, we list multiple joints. -->
            <left_joint>left_front_wheel_joint</left_joint>
            <left_joint>left_middle_wheel_joint</left_joint>
            <left_joint>left_back_wheel_joint</left_joint>

            <right_joint>right_front_wheel_joint</right_joint>
            <right_joint>right_middle_wheel_joint</right_joint>
            <right_joint>right_back_wheel_joint</right_joint>

            <wheel_separation>0.35</wheel_separation>
            <wheel_radius>0.05</wheel_radius>

            <!-- Harmonic specific settings -->
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <tf_topic>tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            
            <odom_publisher_frequency>30</odom_publisher_frequency>

            <max_linear_acceleration>10.0</max_linear_acceleration>
            <max_angular_acceleration>10.0</max_angular_acceleration>
        </plugin>

        <!-- Joint State Publisher for Gazebo -->
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>
    </gazebo>

</robot>